node [shape=box,style="rounded,filled",fillcolor=white,color="#bccbdd",fontname="Hiragino Sans",fontsize=12,margin="0.2,0.12"];
edge [color="#60768d"];
A [label="URLの年月を復元、または年度と月を選ぶ\n会社の表示・追加、または前月の表示設定をコピー"];
B [label="会社ごとに業務内容と報酬タイプを入力\nまたは空の請求前の会社へ前月報酬をコピー"];
